# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_ops

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=playbooks
EMBEDDING_PROVIDER=fastembed

# mock | anthropic | openai | ollama
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=

LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

JWT_SECRET=
